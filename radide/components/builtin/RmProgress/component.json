{
  "schemaVersion": 1,
  "name": "RmProgress",
  "version": "1.0.0",
  "publisher": "RAD IDE",
  "description": "Linear, circular or marquee progress indicator.",
  "category": "Modern (RAD)",
  "order": 3070,
  "builtin": true,
  "prefix": "RmProgress",
  "defaultSize": [
    200,
    8
  ],
  "kind": "visual",
  "hasText": false,
  "commonEvents": true,
  "defaultEvent": "Click",
  "properties": [
    {
      "name": "Value",
      "type": "int",
      "default": 0,
      "category": "Behavior",
      "description": "Current value."
    },
    {
      "name": "Minimum",
      "type": "int",
      "default": 0,
      "category": "Behavior",
      "description": "Lowest value."
    },
    {
      "name": "Maximum",
      "type": "int",
      "default": 100,
      "category": "Behavior",
      "description": "Highest value."
    },
    {
      "name": "Kind",
      "type": "enum",
      "default": "Bar",
      "category": "Appearance",
      "description": "Bar, Circle or Marquee (busy).",
      "choices": [
        "Bar",
        "Circle",
        "Marquee"
      ]
    },
    {
      "name": "ShowText",
      "type": "bool",
      "default": false,
      "category": "Appearance",
      "description": "Shows the percentage."
    },
    {
      "name": "TextFormat",
      "type": "str",
      "default": "",
      "category": "Appearance",
      "description": "Text with {0} = percent, e.g. \"{0}% done\"."
    },
    {
      "name": "Style",
      "type": "enum",
      "default": "Inherit",
      "category": "Appearance",
      "description": "Theme of this control: Inherit = the form's / application's Theme.",
      "choices": [
        "Inherit",
        "Light",
        "Dark",
        "Office",
        "Metro"
      ]
    },
    {
      "name": "AccentColor",
      "type": "color",
      "default": "",
      "category": "Appearance",
      "description": "Accent colour (empty = the theme's accent)."
    }
  ],
  "events": [],
  "methods": [
    {
      "name": "Increment",
      "signature": "Increment(step)",
      "description": "Adds step (1 by default) to Value."
    }
  ],
  "targets": {
    "python-tk": {
      "file": "runtime/rmtk_RmProgress.py",
      "class": "RmProgress",
      "notes": "also draws the control for VB6 (vb-basic) and every GUI Bridge language; native C / C++ / Fortran exes use radforms/controls/rm_*.c"
    }
  },
  "designer": "designer.py",
  "help": "help.md"
}
