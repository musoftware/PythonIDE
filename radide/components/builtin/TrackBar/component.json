      "default": 0,
      "category": "Behavior"
    }
  ],
  "events": [
    {
      "name": "ValueChanged"
    }
  ],
  "targets": {
    "*": {
      "native": true
    }
  },
  "designer": "designer.py",
  "help": "help.md",
