    "imports": [
      "comctllib.slider",
      "mscomctl2.flatscrollbar",
      "mscomctllib.slider",
      "vb.hscrollbar",
      "vb.vscrollbar"
    ],
    "properties": {
      "Minimum": "Min",
      "Maximum": "Max",
      "Value": "Value"
    }
  }
