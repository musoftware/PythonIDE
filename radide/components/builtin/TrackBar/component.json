{
  "schemaVersion": 1,
  "name": "TrackBar",
  "version": "1.0.0",
  "publisher": "RAD IDE",
  "description": "A slider to pick a value.",
  "category": "Common Controls",
  "order": 110,
  "builtin": true,
  "prefix": "TrackBar",
  "defaultSize": [
    104,
    45
  ],
