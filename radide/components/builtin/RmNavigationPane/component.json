{
  "schemaVersion": 1,
  "name": "RmNavigationPane",
  "version": "1.0.0",
  "publisher": "RAD IDE",
  "description": "Navigation pane with page buttons and a header (container, Outlook style).",
  "category": "Modern (RAD)",
  "order": 3140,
  "builtin": true,
  "prefix": "RmNavigationPane",
  "defaultSize": [
    200,
    300
  ],
  "kind": "container",
  "hasText": false,
  "commonEvents": true,
  "defaultEvent": "SelectedIndexChanged",
  "properties": [
    {
      "name": "Pages",
      "type": "list",
      "default": "Mail;Calendar;Contacts",
      "category": "Data",
      "description": "Pages: a;b;c or JSON [{Text, Image}]."
    },
    {
      "name": "SelectedIndex",
      "type": "int",
      "default": 0,
      "category": "Behavior",
      "description": "Page shown."
    },
    {
      "name": "Style",
      "type": "enum",
      "default": "Inherit",
      "category": "Appearance",
      "description": "Theme of this control: Inherit = the form's / application's Theme.",
      "choices": [
        "Inherit",
        "Light",
        "Dark",
        "Office",
        "Metro"
      ]
    },
    {
      "name": "AccentColor",
      "type": "color",
      "default": "",
      "category": "Appearance",
      "description": "Accent colour (empty = the theme's accent)."
    }
  ],
  "events": [
    {
      "name": "SelectedIndexChanged",
      "description": "Another page was selected."
    }
  ],
  "methods": [],
  "targets": {
    "python-tk": {
      "file": "runtime/rmtk_RmNavigationPane.py",
      "class": "RmNavigationPane",
      "notes": "also draws the control for VB6 (vb-basic) and every GUI Bridge language; native C / C++ / Fortran exes use radforms/controls/rm_*.c"
    }
  },
  "designer": "designer.py",
  "help": "help.md"
}
