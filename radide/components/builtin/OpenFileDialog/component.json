{
  "schemaVersion": 1,
  "name": "OpenFileDialog",
  "version": "1.0.0",
  "publisher": "RAD IDE",
  "description": "Asks the user for a file to open: ShowDialog() returns \"OK\" or \"Cancel\".",
  "category": "Dialogs",
  "order": 240,
  "builtin": true,
  "prefix": "OpenFileDialog",
  "defaultSize": [
    0,
    0
  ],
  "kind": "nonvisual",
  "hasText": false,
  "commonEvents": false,
  "properties": [
    {
      "name": "Title",
      "type": "str",
      "default": "Open",
      "category": "Appearance"
    },
    {
      "name": "Filter",
      "type": "str",
      "default": "All files|*.*",
      "category": "Behavior",
      "description": "Pairs of description|pattern, e.g. Text files|*.txt|All|*.*"
    },
    {
      "name": "FileName",
      "type": "str",
      "default": "",
      "category": "Behavior",
      "description": "The chosen file (after ShowDialog)."
    },
    {
      "name": "InitialDirectory",
      "type": "str",
      "default": "",
      "category": "Behavior"
    }
  ],
  "events": [],
  "targets": {
    "*": {
      "native": true
    }
  },
  "help": "help.md",
  "vb6": {
    "class": "MSComDlg.CommonDialog",
    "library": "MSComDlg"
  }
}
