{
  "schemaVersion": 1,
  "name": "RmBalloonTip",
  "version": "1.0.0",
  "publisher": "RAD IDE",
  "description": "Balloon tips that point at a control.",
  "category": "Modern (RAD)",
  "order": 3270,
  "builtin": true,
  "prefix": "RmBalloonTip",
  "defaultSize": [
    0,
    0
  ],
  "kind": "nonvisual",
  "hasText": false,
  "commonEvents": false,
  "properties": [
    {
      "name": "Delay",
      "type": "int",
      "default": 500,
      "category": "Behavior",
      "description": "Milliseconds before a hover tip shows."
    },
    {
      "name": "MaxWidth",
      "type": "int",
      "default": 320,
      "category": "Appearance",
      "description": "Width limit."
    },
    {
      "name": "Duration",
      "type": "int",
      "default": 0,
      "category": "Behavior",
      "description": "Milliseconds a hover tip stays (0 = until the mouse leaves)."
    },
    {
      "name": "Style",
      "type": "enum",
      "default": "Inherit",
      "category": "Appearance",
      "description": "Theme of this control: Inherit = the form's / application's Theme.",
      "choices": [
        "Inherit",
        "Light",
        "Dark",
        "Office",
        "Metro"
      ]
    },
    {
      "name": "AccentColor",
      "type": "color",
      "default": "",
      "category": "Appearance",
      "description": "Accent colour (empty = the theme's accent)."
    }
  ],
  "events": [],
  "methods": [
    {
      "name": "Show",
      "signature": "Show(control, title, text, ms)",
      "description": "Points a balloon at a control."
    },
    {
      "name": "SetToolTip",
      "signature": "SetToolTip(control, title, text)",
      "description": "Hover balloon of a control."
    },
    {
      "name": "Hide",
      "signature": "Hide()",
      "description": "Hides the balloon."
    }
  ],
  "targets": {
    "python-tk": {
      "file": "runtime/rmtk_RmBalloonTip.py",
      "class": "RmBalloonTip",
      "notes": "also draws the control for VB6 (vb-basic) and every GUI Bridge language; native C / C++ / Fortran exes use radforms/controls/rm_*.c"
    }
  },
  "designer": "designer.py",
  "help": "help.md"
}
