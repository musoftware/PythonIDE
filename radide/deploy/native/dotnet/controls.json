    "OpenFileDialog": {"type": "RadNative.RadDialog", "codegen": "Dialog", "nonvisual": true},
    "SaveFileDialog": {"type": "RadNative.RadDialog", "codegen": "Dialog", "nonvisual": true},
    "ColorDialog": {"type": "RadNative.RadDialog", "codegen": "Dialog", "nonvisual": true},
    "FontDialog": {"type": "RadNative.RadDialog", "codegen": "Dialog", "nonvisual": true},
