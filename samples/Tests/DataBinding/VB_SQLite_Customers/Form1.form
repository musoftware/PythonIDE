  "dbsources": [
    {
      "name": "Customers",
      "connection": {
        "name": "Shop",
        "kind": "sqlite",
        "path": "shop.db"
      },
      "table": "Customers",
      "query": "",
      "columns": [
        {
          "name": "Id",
          "type": "INTEGER",
          "pk": 1,
          "autoinc": true
        },
        {
          "name": "Name",
          "type": "TEXT",
          "notnull": true
        },
        {
          "name": "Email",
          "type": "TEXT"
        },
        {
          "name": "City",
          "type": "TEXT"
        },
        {
          "name": "Active",
          "type": "BOOLEAN",
          "default": "1"
        },
        {
          "name": "Balance",
          "type": "REAL",
          "default": "0"
        }
      ],
      "key": [
        "Id"
      ],
      "filter": "",
      "sort": "",
      "autofill": true,
      "dropmode": "details",
      "navigator": {
        "MoveFirst": "CustomersBindingNavigatorMoveFirstItem",
        "MovePrevious": "CustomersBindingNavigatorMovePreviousItem",
        "Position": "CustomersBindingNavigatorPositionItem",
        "MoveNext": "CustomersBindingNavigatorMoveNextItem",
        "MoveLast": "CustomersBindingNavigatorMoveLastItem",
        "AddNew": "CustomersBindingNavigatorAddNewItem",
        "Delete": "CustomersBindingNavigatorDeleteItem",
