  "dbsources": [
    {
      "name": "People",
      "connection": {
        "name": "LocalDb",
        "kind": "mysql",
        "host": "127.0.0.1",
        "port": 3306,
        "user": "radide",
        "database": "radide"
      },
      "table": "People",
      "query": "",
      "columns": [
        {
          "name": "Id",
          "type": "int(11)",
          "pk": 1,
          "autoinc": true,
          "notnull": true
        },
        {
          "name": "Name",
          "type": "varchar(80)",
          "notnull": true
        },
        {
          "name": "City",
          "type": "varchar(60)"
        },
        {
          "name": "Age",
          "type": "int(11)"
        },
        {
          "name": "Score",
          "type": "decimal(6,2)"
        },
        {
          "name": "Active",
          "type": "tinyint(1)",
          "default": "1"
        }
      ],
      "key": [
        "Id"
      ],
      "filter": "",
      "sort": "",
      "autofill": true,
      "navigator": {
        "MoveFirst": "PeopleBindingNavigatorMoveFirstItem",
        "MovePrevious": "PeopleBindingNavigatorMovePreviousItem",
        "Position": "PeopleBindingNavigatorPositionItem",
        "MoveNext": "PeopleBindingNavigatorMoveNextItem",
        "MoveLast": "PeopleBindingNavigatorMoveLastItem",
        "AddNew": "PeopleBindingNavigatorAddNewItem",
        "Delete": "PeopleBindingNavigatorDeleteItem",
        "Save": "PeopleBindingNavigatorSaveItem"
      },
      "dropmode": "details"
    }
  ]
