  "dbsources": [
    {
      "name": "People",
      "connection": {
        "name": "LocalDb",
        "kind": "postgresql",
        "host": "127.0.0.1",
        "port": 5432,
        "user": "radide",
        "database": "radide"
      },
      "table": "people",
      "query": "",
      "columns": [
        {
          "name": "id",
          "type": "integer",
          "pk": 1,
          "autoinc": true,
          "notnull": true
        },
        {
          "name": "name",
          "type": "varchar(80)",
          "notnull": true
        },
        {
          "name": "city",
          "type": "varchar(60)"
        },
        {
          "name": "age",
          "type": "integer"
        },
        {
          "name": "score",
          "type": "numeric(6,2)"
        },
        {
          "name": "active",
          "type": "boolean",
          "default": "true"
        }
      ],
      "key": [
        "id"
      ],
      "filter": "",
      "sort": "",
      "autofill": true,
      "navigator": {
        "MoveFirst": "PeopleBindingNavigatorMoveFirstItem",
        "MovePrevious": "PeopleBindingNavigatorMovePreviousItem",
        "Position": "PeopleBindingNavigatorPositionItem",
        "MoveNext": "PeopleBindingNavigatorMoveNextItem",
        "MoveLast": "PeopleBindingNavigatorMoveLastItem",
        "AddNew": "PeopleBindingNavigatorAddNewItem",
        "Delete": "PeopleBindingNavigatorDeleteItem",
        "Save": "PeopleBindingNavigatorSaveItem"
      },
      "dropmode": "details"
    }
  ]
