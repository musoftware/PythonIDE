        "path": "shop.db"
      },
      "table": "Products",
      "query": "",
      "columns": [
        {
          "name": "Id",
          "type": "INTEGER",
          "pk": 1,
          "autoinc": true
        },
        {
          "name": "Name",
          "type": "TEXT",
          "notnull": true
        },
        {
          "name": "CategoryId",
          "type": "INTEGER"
        },
        {
          "name": "Price",
          "type": "NUMERIC",
          "default": "0"
        },
        {
          "name": "InStock",
          "type": "BOOLEAN",
          "default": "1"
        }
      ],
      "key": [
        "Id"
      ],
      "filter": "",
      "sort": "",
      "autofill": true,
      "dropmode": "details",
