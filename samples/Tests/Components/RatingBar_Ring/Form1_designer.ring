load "guilib.ring"
load "ratingbar.ring"      # component package RatingBar 1.0.0

Form1 = NULL
Form1_Events = NULL
lblTitle = NULL
lblTitle_Events = NULL
rateFood = NULL
rateFood_Events = NULL
rateService = NULL
rateService_Events = NULL
btnReset = NULL
btnReset_Events = NULL
lblResult = NULL
lblResult_Events = NULL

func Form1_Create
    Form1 = new qWidget()
    Form1.setWindowTitle("RatingBar - ring-qt")
    Form1.resize(400, 210)

    lblTitle = new qLabel(Form1)
    lblTitle.setText("Rate the food and the service:")
    lblTitle.setGeometry(12, 12, 360, 17)
    lblTitle.setStyleSheet("font-family:'Segoe UI';font-size:9pt;")
    lblTitle.setAlignment(129)

    rateFood = new RatingBar(Form1)
    rateFood.setValue(3)
    rateFood.setMaxStars(5)
    rateFood.setReadOnly(false)
    rateFood.setStarColor("#FFB400")
    rateFood.setEmptyColor("#C8CDD5")
    rateFood.radBind("ValueChanged", "rateFood_ValueChanged()")
    rateFood.setGeometry(12, 40, 160, 30)

    rateService = new RatingBar(Form1)
    rateService.setValue(2)
    rateService.setMaxStars(4)
    rateService.setReadOnly(false)
    rateService.setStarColor("#E04060")
    rateService.setEmptyColor("#C8CDD5")
    rateService.radBind("ValueChanged", "rateService_ValueChanged()")
    rateService.setGeometry(12, 80, 130, 26)

    btnReset = new qPushButton(Form1)
    btnReset.setText("Reset")
    btnReset.setGeometry(250, 44, 90, 28)
    btnReset.setStyleSheet("font-family:'Segoe UI';font-size:9pt;")
    btnReset.setClickEvent("btnReset_Click()")

    lblResult = new qLabel(Form1)
    lblResult.setText("Click the stars")
    lblResult.setGeometry(12, 124, 360, 17)
    lblResult.setStyleSheet("font-family:'Segoe UI';font-size:9pt;")
    lblResult.setAlignment(129)

    Form1_Load()

func Form1_Show
    if isNull(Form1) Form1_Create() ok
    Form1.show()
