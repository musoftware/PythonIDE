# RingWebLibDemo - builds an HTML page with WebLib (Ring's web library) and opens it

load "weblib.ring"
import System.Web

func main
    aRows = [["Language", "Ring"], ["Library", "WebLib"], ["Version", version()]]
    oPage = new HTMLPageFunctions {
        boxstart()
            text("Hello from Ring WebLib")
            newline()
        boxend()
        divstart([:style = styleWidth("500px")])
            newline()
            text("This page was generated by RingWebLibDemo, a Ring program.")
            newline() newline()
            for aRow in aRows
                text(aRow[1] + " : " + aRow[2])
                newline()
            next
        divend()
    }
    cFile = currentdir() + "/page.html"
    write(cFile, oPage.output())
    see "Written: " + cFile + nl
    system('start "" "' + cFile + '"')
