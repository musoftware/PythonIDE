#--------------------------------------------------------------------
# CodeIgniter Shop (RAD IDE sample) - copy to .env (RAD IDE does it when the project is opened)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# RAD IDE serves the site through CodeIgniter's rewrite.php, so URLs have no index.php.
# app.baseURL is set by the IDE (the Preview's address); set it here for other servers.
app.indexPage = ''
# app.baseURL = 'http://localhost:8080/'

# SQLite3: writable/database.db (created by php spark migrate)
database.default.database = database.db
database.default.DBDriver = SQLite3
database.default.DBPrefix =
database.default.foreignKeys = true

# MariaDB / MySQL instead (e.g. RAD IDE's local server: Databases > Local Servers):
# database.default.hostname = 127.0.0.1
# database.default.database = radide
# database.default.username = radide
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.port = 3306

# shop settings (app/Config/Shop.php)
# shop.currency = EUR

# encryption.key = (php spark key:generate writes it into .env)
