    Form1_Load()

func Form1_Show
    if isNull(Form1) Form1_Create() ok
    Form1.show()

func Form1_ApplySizes
    RadQt_Place(Form1_Lay1)
    return RadVar_Apply(Form1_VSizes, Form1_VCtl, Form1.pObject)

func Form1_CurrentSizes
    return RadVar_Match(Form1_VSizes, QWidget_width(Form1.pObject), QWidget_height(Form1.pObject))
