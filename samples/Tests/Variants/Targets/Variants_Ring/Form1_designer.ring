    lblSide.setAlignment(129)

    pnlMain = new qFrame(Form1, 0)
    pnlMain.setGeometry(20, 80, 600, 300)
    pnlMain.setStyleSheet("background-color:#e8eefc;font-family:'Segoe UI';font-size:9pt;")

    # Animations / layout sizes (RAD IDE): runtime in _radfx.ring
    RadFx_Init(Form1, 1)
    Form1_VSizes = [["small", "", 499, "", "", "", "", "", ""]]
    nW1 = RadFx_Widget(Form1.pObject, 1, 5, "", "", "", 9, 0, 0, "", "", "Sizes (Ring)", 1, "")
    nW2 = RadFx_Widget(btnGo.pObject, 0, 2, "", "", "Segoe UI", 9, 0, 0, "", "", "Go", 1, "#f0f0f0")
    nW3 = RadFx_Widget(lblSide.pObject, 0, 1, "", "", "Segoe UI", 9, 0, 0, "", "", "Side panel", 1, "#f0f0f0")
    Form1_VCtl = [[nW1, Form1.pObject, [], [["Text", "Sizes (Ring)"]], [["small", [["Text", "Sizes (Ring) - small"]], []]]], [nW2, Form1.pObject, [-240, 20, 200, 30, 1, 0, 0, 0], [["Text", "Go"]], [["small", [["Text", "Go (small)"]], [-400, 340, 380, 30, 1, 0, 0, 0]]]], [nW3, Form1.pObject, [], [["Visible", 1]], [["small", [["Visible", 0]], []]]]]

    # Anchor / Dock: re-place the children of Form1 when it is resized
    Form1_Lay1 = [Form1, [pnlMain, 20, 80, -40, -100, 0, 0, 1, 1]]
    Form1_LayEv1 = new qAllEvents(Form1)
    Form1_LayEv1.setEventOutput(false)
    Form1_LayEv1.setResizeEvent("RadQt_Place(Form1_Lay1)")
    Form1.installEventFilter(Form1_LayEv1)

    # layout sizes: re-applied when the window is resized
    oFxV = new qAllEvents(Form1)
    nFxV = RadFx_Keep(oFxV)
    oFxV.setResizeEvent("Form1_ApplySizes() RadFx_Pass(" + nFxV + ")")
