# AUTO-GENERATED by RAD IDE - animations / layout sizes / TwoPane runtime for RingQt forms (do not edit)
load "guilib.ring"

# widgets: [pObject, kind (0 control, 1 window), text kind, bg, fg, font, size, bold, italic, pre, post, alpha,
#           text, visible, parent colour, held]
RadFx_aW = []
# storyboards: [name, widget, tracks, count, forever, autoreverse, delay, restore, duration, chain, on done]
RadFx_aSB = []
# running: [storyboard, t0, direction, t from, hide after]
RadFx_aRun = []
RadFx_aObj = []
RadFx_oTimer = NULL
RadFx_lReduced = 0

func RadFx_Init oParent, lRespect
    if isNull(RadFx_oTimer)
        RadFx_oTimer = new qTimer(oParent)
        RadFx_oTimer.setInterval(15)
        RadFx_oTimer.setTimeoutEvent("RadFx_Tick()")
    ok
    RadFx_lReduced = 0
    if lRespect and trim(sysget("RADIDE_REDUCED_MOTION")) = "1"
        RadFx_lReduced = 1
    ok

func RadFx_Keep oObject
    add(RadFx_aObj, oObject)
    return len(RadFx_aObj)

# qAllEvents eats the event unless setEventOutput(false) is called while it is handled
func RadFx_Pass nObj
    RadFx_aObj[nObj].setEventOutput(false)

func RadFx_Widget pObj, nKind, nText, cBg, cFg, cFont, nSize, lBold, lItalic, cPre, cPost, cText, lVisible, cParent
    add(RadFx_aW, [pObj, nKind, nText, cBg, cFg, cFont, nSize, lBold, lItalic, cPre, cPost, 1, cText, lVisible,
                   cParent, 0])
    return len(RadFx_aW)

func RadFx_Add cName, nW, aTracks, nCount, lForever, lAutoRev, nDelay, lRestore, nDur, cDone
    add(RadFx_aSB, [cName, nW, aTracks, nCount, lForever, lAutoRev, nDelay, lRestore, nDur, [], cDone, []])
    return len(RadFx_aSB)

func RadFx_Chain nAfter, nNext
    add(RadFx_aSB[nAfter][10], nNext)

func RadFx_Ms
    return floor(clock() * 1000 / clockspersecond())

# ------------------------------------------------------------------ property access
func RadFx_Get nW, cProp
    p = RadFx_aW[nW][1]
    switch lower(cProp)
    on "left" return QWidget_x(p)
    on "top" return QWidget_y(p)
    on "width" return QWidget_width(p)
    on "height" return QWidget_height(p)
    on "opacity" return RadFx_aW[nW][12]
    on "backcolor" return RadFx_aW[nW][4]
    on "forecolor" return RadFx_aW[nW][5]
    on "fontsize" return RadFx_aW[nW][7]
    on "fontbold" return RadFx_aW[nW][8]
    on "text" return RadFx_aW[nW][13]
    on "visible" return RadFx_aW[nW][14]
    off
    return 0

func RadFx_Set nW, cProp, v
    p = RadFx_aW[nW][1]
    switch lower(cProp)
    on "left"
        QWidget_move(p, floor(v + 0.5), QWidget_y(p))
    on "top"
        QWidget_move(p, QWidget_x(p), floor(v + 0.5))
    on "width"
        if v < 0 v = 0 ok
        QWidget_resize(p, floor(v + 0.5), QWidget_height(p))
    on "height"
        if v < 0 v = 0 ok
        QWidget_resize(p, QWidget_width(p), floor(v + 0.5))
    on "opacity"
        if v < 0 v = 0 ok
        if v > 1 v = 1 ok
        RadFx_aW[nW][12] = v
        if RadFx_aW[nW][2] = 1
            QWidget_setWindowOpacity(p, v)
        else
            RadFx_Style(nW)
        ok
    on "backcolor"
        RadFx_aW[nW][4] = v
        RadFx_Style(nW)
    on "forecolor"
        RadFx_aW[nW][5] = v
        RadFx_Style(nW)
    on "fontsize"
        if v < 1 v = 1 ok
        RadFx_aW[nW][7] = floor(v + 0.5)
        RadFx_Style(nW)
    on "fontbold"
        RadFx_aW[nW][8] = v
        RadFx_Style(nW)
    on "text"
        RadFx_aW[nW][13] = v
        RadFx_SetText(nW, v)
    on "visible"
        RadFx_aW[nW][14] = v
        if v QWidget_show(p) else QWidget_hide(p) ok
    off

func RadFx_SetText nW, cText
    p = RadFx_aW[nW][1]
    switch RadFx_aW[nW][3]
    on 1 QLabel_setText(p, cText)
    on 2 QAbstractButton_setText(p, cText)
    on 3 QLineEdit_setText(p, cText)
    on 4 QGroupBox_setTitle(p, cText)
    on 5 QWidget_setWindowTitle(p, cText)
    on 6 QTextEdit_setPlainText(p, cText)
    off

func RadFx_Rgb cColor
    c = trim("" + cColor)
    if len(c) = 4 and left(c, 1) = "#"
        c = "#" + c[2] + c[2] + c[3] + c[3] + c[4] + c[4]
    ok
    if len(c) < 7 or left(c, 1) != "#" return [] ok
    return [dec(substr(c, 2, 2)), dec(substr(c, 4, 2)), dec(substr(c, 6, 2))]

func RadFx_Css cColor, nAlpha
    if nAlpha >= 1 return cColor ok
    a = RadFx_Rgb(cColor)
    if len(a) = 0 return cColor ok
    return "rgba(" + a[1] + "," + a[2] + "," + a[3] + "," + nAlpha + ")"

func RadFx_Style nW
    w = RadFx_aW[nW]
    if w[2] = 1
        if w[4] != "" QWidget_setStyleSheet(w[1], "background-color:" + w[4] + ";") ok
        return
    ok
    a = w[12]
    c = w[10]
    if w[4] != ""
        c += "background-color:" + RadFx_Css(w[4], a) + ";"
    ok
    if w[5] != ""
        c += "color:" + RadFx_Css(w[5], a) + ";"
    but a < 1
        c += "color:" + RadFx_Css("#000000", a) + ";"
    ok
    c += "font-family:'" + w[6] + "';font-size:" + w[7] + "pt;"
    if w[8] c += "font-weight:bold;" ok
    if w[9] c += "font-style:italic;" ok
    c += w[11]
    QWidget_setStyleSheet(w[1], c)

# ------------------------------------------------------------------ easing / values
func RadFx_Ease f, cEase
    switch cEase
    on "in" return f * f
    on "out" return 1 - (1 - f) * (1 - f)
    on "inout"
        if f < 0.5 return 2 * f * f ok
        return 1 - 2 * (1 - f) * (1 - f)
    on "sine" return (1 - cos(3.14159265358979 * f)) / 2
    on "back" return 1 + 2.70158 * pow(f - 1, 3) + 1.70158 * pow(f - 1, 2)
    on "elastic"
        if f <= 0 return 0 ok
        if f >= 1 return 1 ok
        return pow(2, -10 * f) * sin((f * 10 - 0.75) * (2 * 3.14159265358979 / 3)) + 1
    on "bounce"
        n = 7.5625
        d = 2.75
        if f < 1 / d return n * f * f ok
        if f < 2 / d
            f -= 1.5 / d
            return n * f * f + 0.75
        ok
        if f < 2.5 / d
            f -= 2.25 / d
            return n * f * f + 0.9375
        ok
        f -= 2.625 / d
        return n * f * f + 0.984375
    off
    return f

func RadFx_IsColor cProp
    c = lower(cProp)
    return c = "backcolor" or c = "forecolor"

func RadFx_IsInt cProp
    c = lower(cProp)
    return c = "left" or c = "top" or c = "width" or c = "height" or c = "fontsize"

# a keyframe value: [ms, kind, a, b, c, s, ease]  kind 0 number a, 1 start * a + b + c * start(s),
# 2 string s, 3 parent colour, 4 typewriter share a, 5 boolean a
func RadFx_Value nW, cProp, k, vStart, aStarts
    switch k[2]
    on 0 return k[3]
    on 1
        if isString(vStart) return vStart ok
        v = vStart * k[3] + k[4]
        if k[6] != "" v += k[5] * RadFx_StartOf(nW, k[6], aStarts) ok
        if lower(cProp) = "opacity"
            if v < 0 v = 0 ok
            if v > 1 v = 1 ok
        ok
        return v
    on 2 return k[6]
    on 3 return RadFx_aW[nW][15]
    on 4 return k[3]
    on 5 return k[3]
    on 6 return vStart
    off
    return vStart

func RadFx_StartOf nW, cProp, aStarts
    for s in aStarts
        if lower(s[1]) = lower(cProp) return s[2] ok
    next
    return RadFx_Get(nW, cProp)

func RadFx_Mix cProp, a, b, f
    if f <= 0 return a ok
    if RadFx_IsColor(cProp)
        if f >= 1 return b ok
        ca = RadFx_Rgb(a)
        cb = RadFx_Rgb(b)
        if len(ca) = 0 or len(cb) = 0 return a ok
        c = "#"
        for i = 1 to 3
            x = floor(ca[i] + (cb[i] - ca[i]) * f + 0.5)
            if x < 0 x = 0 ok
            if x > 255 x = 255 ok
            h = hex(x)
            if len(h) < 2 h = "0" + h ok
            c += h
        next
        return c
    ok
    if isString(a) or isString(b) or lower(cProp) = "visible" or lower(cProp) = "fontbold"
        if f >= 1 return b ok
        return a
    ok
    return a + (b - a) * f

func RadFx_TrackAt nW, aTrack, t, vStart, aStarts
    cProp = aTrack[1]
    aKeys = aTrack[2]
    if len(aKeys) = 0 return vStart ok
    t0 = 0
    v0 = vStart
    if aKeys[1][1] <= 0
        v0 = RadFx_Value(nW, cProp, aKeys[1], vStart, aStarts)
        if t <= 0 or len(aKeys) = 1 return v0 ok
    ok
    for k in aKeys
        if k[1] > t0 or (k[1] = t0 and t0 > 0)
            v1 = RadFx_Value(nW, cProp, k, vStart, aStarts)
            if t <= k[1]
                f = 1
                if k[1] > t0 f = (t - t0) / (k[1] - t0) ok
                return RadFx_Mix(cProp, v0, v1, RadFx_Ease(f, k[7]))
            ok
            t0 = k[1]
            v0 = v1
        ok
    next
    return v0

func RadFx_Apply nSB, t, aStarts
    sb = RadFx_aSB[nSB]
    nW = sb[2]
    p = RadFx_aW[nW][1]
    x = QWidget_x(p)
    y = QWidget_y(p)
    w = QWidget_width(p)
    h = QWidget_height(p)
    lGeo = 0
    for i = 1 to len(sb[3])
        tr = sb[3][i]
        v = RadFx_TrackAt(nW, tr, t, aStarts[i][2], aStarts)
        c = lower(tr[1])
        if c = "text"
            n = len(aStarts[i][3])
            RadFx_aW[nW][13] = aStarts[i][3]
            RadFx_SetText(nW, left(aStarts[i][3], floor(n * v + 0.5)))
        but c = "left"
            x = v
            lGeo = 1
        but c = "top"
            y = v
            lGeo = 1
        but c = "width"
            w = v
            lGeo = 1
        but c = "height"
            h = v
            lGeo = 1
        else
            RadFx_Set(nW, tr[1], v)
        ok
    next
    if lGeo
        if w < 0 w = 0 ok
        if h < 0 h = 0 ok
        QWidget_setGeometry(p, floor(x + 0.5), floor(y + 0.5), floor(w + 0.5), floor(h + 0.5))
    ok

func RadFx_Starts nSB
    sb = RadFx_aSB[nSB]
    aOut = []
    for tr in sb[3]
        c = lower(tr[1])
        if c = "text"
            add(aOut, [tr[1], 1, RadFx_aW[sb[2]][13]])
        else
            add(aOut, [tr[1], RadFx_Get(sb[2], tr[1]), ""])
        ok
    next
    return aOut

# ------------------------------------------------------------------ playing
func RadFx_Find nSB
    for i = 1 to len(RadFx_aRun)
        if RadFx_aRun[i][1] = nSB return i ok
    next
    return 0

func RadFx_Begin nSB
    RadFx_Play(nSB, 0)

func RadFx_Play nSB, lHide
    if nSB < 1 or nSB > len(RadFx_aSB) return ok
    i = RadFx_Find(nSB)
    if i > 0
        aStarts = RadFx_aRun[i][6]
        del(RadFx_aRun, i)
    else
        aStarts = RadFx_Starts(nSB)
    ok
    sb = RadFx_aSB[nSB]
    if RadFx_lReduced or sb[9] <= 0
        RadFx_End(nSB, aStarts, lHide)
        return
    ok
    add(RadFx_aRun, [nSB, RadFx_Ms(), 1, 0, lHide, aStarts])
    RadFx_aW[sb[2]][16] = 1
    if sb[7] <= 0 RadFx_Apply(nSB, 0, aStarts) ok
    if not RadFx_oTimer.isActive() RadFx_oTimer.start() ok

func RadFx_End nSB, aStarts, lHide
    sb = RadFx_aSB[nSB]
    t = sb[9]
    if sb[6] t = 0 ok
    RadFx_Apply(nSB, t, aStarts)
    RadFx_aSB[nSB][12] = aStarts
    RadFx_aW[sb[2]][16] = 0
    if lHide RadFx_Set(sb[2], "Visible", 0) ok
    if not RadFx_aW[sb[2]][14]
        # hidden at the end (exit): colours / opacity come back for the next show
        for s in aStarts
            c = lower(s[1])
            if c = "backcolor" or c = "forecolor" or c = "opacity" RadFx_Set(sb[2], s[1], s[2]) ok
        next
    ok
    for n in sb[10]
        RadFx_Begin(n)
    next
    if sb[11] != "" eval(sb[11]) ok

func RadFx_Stop nSB
    i = RadFx_Find(nSB)
    if i > 0
        RadFx_aW[RadFx_aSB[nSB][2]][16] = 0
        del(RadFx_aRun, i)
    ok

# hover left: "reverse" plays back from where it is, "stop" stops, "none" lets it finish
func RadFx_Leave nSB, cMode
    if cMode = "none" return ok
    i = RadFx_Find(nSB)
    if cMode = "stop"
        RadFx_Stop(nSB)
        return
    ok
    if i = 0
        # already at its end: play it back from there
        sb = RadFx_aSB[nSB]
        if sb[6] or len(sb[12]) = 0 return ok
        add(RadFx_aRun, [nSB, RadFx_Ms(), -1, sb[9], 0, sb[12]])
        RadFx_aW[sb[2]][16] = 1
        if not RadFx_oTimer.isActive() RadFx_oTimer.start() ok
        return
    ok
    r = RadFx_aRun[i]
    t = RadFx_Time(r, RadFx_Ms())
    if t < 0 t = 0 ok
    RadFx_aRun[i][2] = RadFx_Ms()
    RadFx_aRun[i][3] = -1
    RadFx_aRun[i][4] = t

# position (ms) of running entry r at time nNow (-1 = still waiting for its delay, -2 = finished)
func RadFx_Time r, nNow
    sb = RadFx_aSB[r[1]]
    nDur = sb[9]
    if r[3] = -1
        t = r[4] - (nNow - r[2])
        if t <= 0 return -2 ok
        return t
    ok
    e = nNow - r[2] - sb[7]
    if e < 0 return -1 ok
    nCycle = nDur
    if sb[6] nCycle = nDur * 2 ok
    nIter = floor(e / nCycle)
    if not sb[5] and nIter >= sb[4] return -2 ok
    lt = e - nIter * nCycle
    if sb[6] and lt > nDur return 2 * nDur - lt ok
    return lt

func RadFx_Tick
    nNow = RadFx_Ms()
    aDone = []
    for r in RadFx_aRun
        t = RadFx_Time(r, nNow)
        if t = -2
            add(aDone, r)
        but t >= 0
            RadFx_Apply(r[1], t, r[6])
        ok
    next
    for r in aDone
        i = RadFx_Find(r[1])
        if i > 0 del(RadFx_aRun, i) ok
        if r[3] = -1
            RadFx_Apply(r[1], 0, r[6])
            RadFx_aW[RadFx_aSB[r[1]][2]][16] = 0
        else
            RadFx_End(r[1], r[6], r[5])
        ok
    next
    if len(RadFx_aRun) = 0 RadFx_oTimer.stop() ok

func RadFx_ByName cName
    for i = 1 to len(RadFx_aSB)
        if lower(RadFx_aSB[i][1]) = lower(cName) return i ok
    next
    return 0

# Visible from code with the On show / On hide animations: aShow / aHide = storyboards of the widget
func RadFx_SetVisible nW, lOn, aShow, aHide
    if lOn
        RadFx_Set(nW, "Visible", 1)
        for n in aShow RadFx_Begin(n) next
        return
    ok
    if len(aHide) = 0
        RadFx_Set(nW, "Visible", 0)
        return
    ok
    for i = 1 to len(aHide)
        RadFx_Play(aHide[i], i = len(aHide))
    next

# ------------------------------------------------------------------ layout sizes (variants)
func RadVar_Posture
    c = lower(trim(sysget("RADIDE_POSTURE")))
    c = substr(substr(substr(c, "-", ""), "_", ""), " ", "")
    if c = "halfopened" or c = "halfopen" or c = "half" or c = "tabletop" or c = "book" return "half-opened" ok
    if c = "folded" or c = "closed" or c = "fold" or c = "cover" return "folded" ok
    return "flat"

func RadVar_Span
    c = lower(trim(sysget("RADIDE_SPAN")))
    if c = "dual" or c = "2" or c = "spanned" return "dual" ok
    if RadVar_Posture() = "half-opened" return "dual" ok
    return "single"

func RadVar_Fold
    a = str2list(substr(trim(sysget("RADIDE_HINGE")), ",", nl))
    if len(a) != 4 return "" ok
    if number(a[4]) >= number(a[3]) return "vertical" ok
    return "horizontal"

# aSizes rows: [id, minW, maxW, minH, maxH, orientation, posture, span, fold]  ("" = any)
func RadVar_Match aSizes, w, h
    cOrient = "portrait"
    if w > h cOrient = "landscape" ok
    cPosture = RadVar_Posture()
    cSpan = RadVar_Span()
    cFold = RadVar_Fold()
    aOut = []
    for s in aSizes
        ok1 = 1
        if not isString(s[2])
            if w < s[2] ok1 = 0 ok
        ok
        if not isString(s[3])
            if w > s[3] ok1 = 0 ok
        ok
        if not isString(s[4])
            if h < s[4] ok1 = 0 ok
        ok
        if not isString(s[5])
            if h > s[5] ok1 = 0 ok
        ok
        if s[6] != "" and s[6] != cOrient ok1 = 0 ok
        if s[7] != "" and s[7] != cPosture ok1 = 0 ok
        if s[8] != "" and s[8] != cSpan ok1 = 0 ok
        if s[9] != "" and s[9] != cFold ok1 = 0 ok
        if ok1 add(aOut, s[1]) ok
    next
    return aOut

# aCtl rows: [widget, parent pObject, base place, base props, [[size id, props, place], ...]]
# place = [x, y, w, h, rx, ry, rw, rh] (layout.Place) or []; props = [[property, value], ...]
func RadVar_Apply aSizes, aCtl, pHost
    aAct = RadVar_Match(aSizes, QWidget_width(pHost), QWidget_height(pHost))
    for row in aCtl
        nW = row[1]
        aPlace = row[3]
        aProps = row[4]
        for cId in aAct
            for ov in row[5]
                if ov[1] = cId
                    if len(ov[3]) aPlace = ov[3] ok
                    for pv in ov[2]
                        lFound = 0
                        for j = 1 to len(aProps)
                            if aProps[j][1] = pv[1]
                                aProps[j][2] = pv[2]
                                lFound = 1
                            ok
                        next
                        if not lFound add(aProps, pv) ok
                    next
                ok
            next
        next
        if len(aPlace) and not RadFx_aW[nW][16]
            p = RadFx_aW[nW][1]
            pp = row[2]
            cw = QWidget_width(pp)
            ch = QWidget_height(pp)
            nWd = floor(aPlace[3] + aPlace[7] * cw + 0.5)
            nHt = floor(aPlace[4] + aPlace[8] * ch + 0.5)
            if nWd < 0 nWd = 0 ok
            if nHt < 0 nHt = 0 ok
            QWidget_setGeometry(p, floor(aPlace[1] + aPlace[5] * cw + 0.5), floor(aPlace[2] + aPlace[6] * ch + 0.5),
                                nWd, nHt)
        ok
        for pv in aProps
            vNow = RadFx_Get(nW, pv[1])
            lSet = 1
            if isString(vNow) = isString(pv[2])
                if vNow = pv[2] lSet = 0 ok
            ok
            if lSet RadFx_Set(nW, pv[1], pv[2]) ok
        next
    next
    return aAct

# ------------------------------------------------------------------ TwoPane (desktop: Ratio / RADIDE_HINGE)
# aPane = [box pObject, start pObject or NULL, end pObject or NULL, mode, ratio, single (1 start, 2 end), hinge aware]
func RadPane_Place aPane
    pBox = aPane[1]
    w = QWidget_width(pBox)
    h = QWidget_height(pBox)
    cMode = lower(aPane[4])
    r = aPane[5]
    aH = str2list(substr(trim(sysget("RADIDE_HINGE")), ",", nl))
    if aPane[7] and len(aH) = 4
        hx = number(aH[1]) - QWidget_x(pBox)
        hy = number(aH[2]) - QWidget_y(pBox)
        hw = number(aH[3])
        hh = number(aH[4])
        if hw <= hh and hx > 0 and hx + hw < w and (cMode = "auto" or cMode = "horizontal")
            RadPane_Put(aPane[2], 0, 0, hx, h)
            RadPane_Put(aPane[3], hx + hw, 0, w - hx - hw, h)
            return
        ok
        if hw > hh and hy > 0 and hy + hh < h and (cMode = "auto" or cMode = "vertical")
            RadPane_Put(aPane[2], 0, 0, w, hy)
            RadPane_Put(aPane[3], 0, hy + hh, w, h - hy - hh)
            return
        ok
    ok
    if cMode = "auto"
        if w < 600
            if aPane[6] = 2
                RadPane_Put(aPane[3], 0, 0, w, h)
                if not isNull(aPane[2]) QWidget_hide(aPane[2]) ok
            else
                RadPane_Put(aPane[2], 0, 0, w, h)
                if not isNull(aPane[3]) QWidget_hide(aPane[3]) ok
            ok
            return
        ok
        cMode = "horizontal"
    ok
    if cMode = "vertical"
        a = floor(h * r + 0.5)
        RadPane_Put(aPane[2], 0, 0, w, a)
        RadPane_Put(aPane[3], 0, a, w, h - a)
    else
        a = floor(w * r + 0.5)
        RadPane_Put(aPane[2], 0, 0, a, h)
        RadPane_Put(aPane[3], a, 0, w - a, h)
    ok

func RadPane_Put p, x, y, w, h
    if isNull(p) return ok
    QWidget_setGeometry(p, x, y, w, h)
    QWidget_show(p)

func RadFx_WidgetOf pObj
    for i = 1 to len(RadFx_aW)
        if ptrcmp(RadFx_aW[i][1], pObj) return i ok
    next
    return 0
