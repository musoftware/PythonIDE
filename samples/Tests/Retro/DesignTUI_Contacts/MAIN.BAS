SUB TuiFire (i, ev)
SELECT CASE i * 4 + ev
CASE 41: lstContactsClick
CASE 45: btnAddClick
CASE 49: btnClearClick
CASE 77: btnBackClick
END SELECT
END SUB

SUB TuiFireMenu (k)
SELECT CASE k
CASE 1: mnuNewClick
CASE 3: mnuExitClick
CASE 4: mnuAboutClick
END SELECT
END SUB

