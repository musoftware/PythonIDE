  TuiShowScreen About
' <<< END USER CODE
END SUB

SUB lstContactsClick
' >>> USER CODE lstContacts_Click (kept when the screens are regenerated)
  k = TuiGetValue(lstContacts)
  TuiSetText lblInfo, "Selected: " + TuiGetItem$(lstContacts, k)
' <<< END USER CODE
END SUB

SUB btnAddClick
' >>> USER CODE btnAdd_Click (kept when the screens are regenerated)
  n$ = TuiGetText$(txtName)
  IF LEN(n$) = 0 THEN TuiMsgBox "Contacts", "Type a name first.": EXIT SUB
  e$ = n$
  IF LEN(TuiGetText$(txtPhone)) THEN e$ = e$ + "  " + TuiGetText$(txtPhone)
  IF TuiGetValue(chkFav) THEN e$ = e$ + "  *"
  TuiAddItem lstContacts, e$
  TuiSetText txtName, ""
  TuiSetText txtPhone, ""
  TuiSetValue prgCount, TuiGetValue(prgCount) + 1
  TuiSetText lblInfo, "Added: " + n$
' <<< END USER CODE
END SUB

SUB btnClearClick
' >>> USER CODE btnClear_Click (kept when the screens are regenerated)
  TuiClearList lstContacts
  TuiSetValue prgCount, 0
  TuiSetText lblInfo, "The list is empty."
' <<< END USER CODE
END SUB

SUB btnBackClick
' >>> USER CODE btnBack_Click (kept when the screens are regenerated)
  TuiShowScreen Main
' <<< END USER CODE
END SUB

