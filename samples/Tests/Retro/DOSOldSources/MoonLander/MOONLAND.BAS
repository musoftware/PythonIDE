10 REM MOON LANDER - an old-style line-numbered BASIC game (original RAD IDE sample)
20 CLS
30 PRINT "MOON LANDER": PRINT
40 H = 500: V = 0: F = 120: T = 0
50 PRINT "TIME"; T; " HEIGHT"; H; " SPEED"; V; " FUEL"; F
60 IF F <= 0 THEN B = 0: GOTO 100
70 INPUT "BURN (0-30)"; B
80 IF B < 0 OR B > 30 THEN PRINT "0 TO 30 PLEASE": GOTO 70
90 IF B > F THEN B = F
100 F = F - B: V = V + 10 - B: H = H - V: T = T + 1
110 IF H > 0 THEN 50
120 IF V <= 10 THEN PRINT "SAFE LANDING!" ELSE PRINT "CRASH AT"; V; "M/S"
130 GOSUB 1000
140 END
1000 REM ---- SCORE ----
1010 S = F * 10 - T
1020 PRINT "SCORE"; S
1030 RETURN
