  "storyboards": [
    {
      "name": "Storyboard1",
      "autostart": false,
      "repeat": false,
      "autoreverse": false,
      "tracks": [
        {
          "target": "Button1",
          "property": "Left",
          "keys": [
            [
              0,
              10
            ],
            [
              600,
              210
            ]
          ]
        },
        {
          "target": "Label1",
          "property": "BackColor",
          "keys": [
            [
              0,
              "#000000"
            ],
            [
              600,
              "#ffffff"
            ]
          ]
        }
      ]
    },
    {
      "name": "Intro",
      "autostart": true,
      "tracks": [
        {
          "target": "NumericUpDown1",
          "property": "Top",
          "keys": [
            [
              300,
              170,
              "out"
            ]
          ]
        }
      ]
    }
  ],
  "datasources": [
    {
      "name": "People",
      "file": "people.json"
    },
    {
      "name": "Cities",
      "file": "cities.csv"
    }
  ],
  "bindings": [
    {
      "control": "ListBox1",
      "property": "Items",
      "source": "People",
      "field": "name"
    },
    {
      "control": "Label1",
      "property": "Text",
      "source": "People",
      "field": "name"
    },
    {
      "control": "NumericUpDown1",
      "property": "Value",
      "source": "People",
      "field": "age"
    },
    {
      "control": "ComboBox1",
      "property": "Items",
      "source": "Cities",
      "field": "city"
    }
  ]
}