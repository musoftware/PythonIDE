  },
  "controls": [
    {
      "type": "Button",
      "props": {
        "Name": "Button1",
        "Text": "Buy",
        "Left": 20,
        "Top": 20,
        "Width": 75,
        "Height": 23,
        "BackColor": "#cccccc",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Left",
        "Parent": ""
      },
      "states": {
        "MouseOver": {
          "BackColor": "#00aa00",
          "Text": "Buy now!"
        }
      }
    },
    {
      "type": "ListBox",
      "props": {
        "Name": "ListBox1",
        "Left": 20,
        "Top": 70,
        "Width": 160,
        "Height": 100,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
