# syntax=docker/dockerfile:1
# .NET - ASP.NET Core - generated by RAD IDE (Docker > Generate Dockerfile).
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY AspNetMinimal.csproj ./
RUN dotnet restore "AspNetMinimal.csproj"
COPY . .
RUN dotnet publish "AspNetMinimal.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "AspNetMinimal.dll"]
