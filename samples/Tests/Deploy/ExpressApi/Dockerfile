# syntax=docker/dockerfile:1
# Node.js (Express / any server) - generated by RAD IDE (Docker > Generate Dockerfile).
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY --chown=node:node . .

USER node
ENV PORT=3000
EXPOSE 3000
CMD ["npm", "start"]
