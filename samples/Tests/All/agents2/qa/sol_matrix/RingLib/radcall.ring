# radcall.ring - call functions written in other languages of a RAD IDE project
#
#   x = radcall("MathVB.AddNumbers", [2, 3])     # Function AddNumbers in MathVB.bas
#   s = radcall("Helpers.shout", ["hello"])      # def shout in Helpers.py
#   radcall("Form2.Show", [])                    # open a form written in any language
#
# Arguments are always passed as one Ring list. Values travel as JSON:
#   number <-> number, string <-> string, list <-> JSON array,
#   JSON object <-> Ring list of [key, value] pairs (read with radget(obj, "key")),
#   true -> 1, false -> 0, null -> "" (NULL).
# Errors are raised as Ring runtime errors (use try/catch).
#
# The IDE runs a RAD Hub for every Run/Debug (env RAD_HUB = 127.0.0.1:<port>).
# Generated by RAD IDE - it is copied into the project when a program runs.

load "sockets.ring"

$radIsWorker = false
$radSock = NULL
$radBuf = ""
$radNextId = 0
$radArgs = []
$radRes = NULL
$radQ = '"'
$radBS = char(92)
$radJ = ""
$radJP = 1

# ============================================================== public API
func radcall cName, aArgs
	if ! isList(aArgs)
		aArgs = [aArgs]
	ok
	$radNextId++
	nId = $radNextId
	cReq = '{"id":' + nId + ',"call":' + radJsonStr(cName) + ',"args":' + radJsonArr(aArgs) + '}'
	if $radIsWorker
		aMsg = radWorkerCall(cReq, nId)
	else
		aMsg = radTcpCall(cReq, nId)
	ok
	if radHas(aMsg, "error")
		raise("RadCall error: " + radget(aMsg, "error"))
	ok
	return radget(aMsg, "result")

func radget aObj, cKey
	# value of cKey in a decoded JSON object (list of [key, value] pairs), NULL if missing
	if ! isList(aObj) return NULL ok
	for aPair in aObj
		if isList(aPair) and len(aPair) = 2 and isString(aPair[1]) and aPair[1] = cKey
			return aPair[2]
		ok
	next
	return NULL

func radHas aObj, cKey
	if ! isList(aObj) return false ok
	for aPair in aObj
		if isList(aPair) and len(aPair) = 2 and isString(aPair[1]) and aPair[1] = cKey
			return true
		ok
	next
	return false

# ============================================================== TCP (normal programs)
func radTcpCall cReq, nId
	if isNull($radSock)
		cHub = sysget("RAD_HUB")
		if cHub = ""
			raise("RAD_HUB is not set - run the program from RAD IDE")
		ok
		nPos = substr(cHub, ":")
		cHost = left(cHub, nPos - 1)
		nPort = 0 + substr(cHub, nPos + 1)
		$radSock = socket(AF_INET, SOCK_STREAM, 0)
		connect($radSock, cHost, nPort)
	ok
	send($radSock, cReq + char(10))
	while true
		nNl = substr($radBuf, char(10))
		while nNl = 0
			cData = recv($radSock, 65536)
			if isNull(cData) or cData = ""
				close($radSock)
				$radSock = NULL
				raise("the RAD Hub closed the connection")
			ok
			$radBuf += cData
			nNl = substr($radBuf, char(10))
		end
		cLine = left($radBuf, nNl - 1)
		$radBuf = substr($radBuf, nNl + 1)
		aMsg = radJsonParse(cLine)
		if radget(aMsg, "id") = nId
			return aMsg
		ok
	end

# ============================================================== worker (served by RAD Hub)
func radWorkerServe
	$radIsWorker = true
	while true
		give cLine
		if cLine = ""
			return
		ok
		aMsg = radJsonParse(cLine)
		if radHas(aMsg, "func")
			radServeOne(aMsg)
		ok
	end

func radWorkerCall cReq, nId
	radOut(cReq)
	while true
		give cLine
		if cLine = ""
			raise("the RAD Hub closed the worker")
		ok
		aMsg = radJsonParse(cLine)
		if radHas(aMsg, "func")
			radServeOne(aMsg)          # a call back into this worker while we wait
		elseif radget(aMsg, "id") = nId
			return aMsg
		ok
	end

func radOut cLine
	fputs(stdout, cLine + nl)
	fflush(stdout)

func radServeOne aMsg
	nId = radget(aMsg, "id")
	cFunc = radget(aMsg, "func")
	aArgs = radget(aMsg, "args")
	if ! isList(aArgs) aArgs = [] ok
	cErr = ""
	if ! radIsIdent(cFunc)
		cErr = "bad function name '" + cFunc + "'"
	elseif ! find(functions(), lower(cFunc))
		cErr = "function '" + cFunc + "' was not found"
	ok
	if cErr = ""
		$radArgs = aArgs
		cCode = "$radRes = " + cFunc + "("
		for i = 1 to len(aArgs)
			if i > 1 cCode += "," ok
			cCode += "$radArgs[" + i + "]"
		next
		cCode += ")"
		$radRes = NULL
		try
			eval(cCode)
			vRes = $radRes
		catch
			cErr = cCatchError
		done
	ok
	if cErr != ""
		radOut('{"id":' + radJsonValue(nId) + ',"error":' + radJsonStr(cErr) + '}')
	else
		radOut('{"id":' + radJsonValue(nId) + ',"result":' + radJsonValue(vRes) + '}')
	ok

func radIsIdent cName
	if ! isString(cName) or cName = "" return false ok
	for i = 1 to len(cName)
		c = cName[i]
		if ! (isalnum(c) or c = "_") return false ok
	next
	return true

# ============================================================== JSON encode
func radJsonValue v
	if isNumber(v) return radJsonNum(v) ok
	if isString(v) return radJsonStr(v) ok
	if isObject(v) return radJsonObj(v) ok
	if isList(v)
		if radIsPairs(v) return radJsonPairs(v) ok
		return radJsonArr(v)
	ok
	return "null"

func radJsonNum n
	if n = floor(n) and fabs(n) < 1000000000000000
		return "" + n
	ok
	cSign = ""
	if n < 0
		cSign = "-"
		n = -n
	ok
	nInt = floor(n)
	nFrac = n - nInt
	cFrac = ""
	for i = 1 to 12
		nFrac *= 10
		nD = floor(nFrac)
		cFrac += ("" + nD)
		nFrac -= nD
	next
	while len(cFrac) > 1 and right(cFrac, 1) = "0"
		cFrac = left(cFrac, len(cFrac) - 1)
	end
	return cSign + nInt + "." + cFrac

func radIsPairs v
	if len(v) = 0 return false ok
	for x in v
		if ! (isList(x) and len(x) = 2 and isString(x[1])) return false ok
	next
	return true

func radJsonArr v
	c = "["
	for i = 1 to len(v)
		if i > 1 c += "," ok
		c += radJsonValue(v[i])
	next
	return c + "]"

func radJsonPairs v
	c = "{"
	for i = 1 to len(v)
		if i > 1 c += "," ok
		c += radJsonStr(v[i][1]) + ":" + radJsonValue(v[i][2])
	next
	return c + "}"

func radJsonObj o
	c = "{"
	aNames = attributes(o)
	for i = 1 to len(aNames)
		if i > 1 c += "," ok
		c += radJsonStr(aNames[i]) + ":" + radJsonValue(getattribute(o, aNames[i]))
	next
	return c + "}"

func radJsonStr s
	s = "" + s
	c = $radQ
	for i = 1 to len(s)
		ch = s[i]
		n = ascii(ch)
		if ch = $radQ
			c += $radBS + $radQ
		elseif ch = $radBS
			c += $radBS + $radBS
		elseif n = 10
			c += $radBS + "n"
		elseif n = 13
			c += $radBS + "r"
		elseif n = 9
			c += $radBS + "t"
		elseif n < 32
			c += $radBS + "u00" + radHex2(n)
		else
			c += ch
		ok
	next
	return c + $radQ

func radHex2 n
	cDigits = "0123456789abcdef"
	return cDigits[floor(n / 16) + 1] + cDigits[(n % 16) + 1]

# ============================================================== JSON decode

func radJsonParse cText
	$radJ = cText
	$radJP = 1
	v = radJParseValue()
	return v

func radJSkip
	while $radJP <= len($radJ)
		n = ascii($radJ[$radJP])
		if n = 32 or n = 9 or n = 10 or n = 13
			$radJP++
		else
			exit
		ok
	end

func radJParseValue
	radJSkip()
	if $radJP > len($radJ) raise("radcall: bad JSON (unexpected end)") ok
	ch = $radJ[$radJP]
	if ch = "{" return radJParseObject() ok
	if ch = "[" return radJParseArray() ok
	if ch = $radQ return radJParseString() ok
	if substr($radJ, $radJP, 4) = "true"
		$radJP += 4
		return 1
	ok
	if substr($radJ, $radJP, 5) = "false"
		$radJP += 5
		return 0
	ok
	if substr($radJ, $radJP, 4) = "null"
		$radJP += 4
		return NULL
	ok
	return radJParseNumber()

func radJParseObject
	aOut = []
	$radJP++
	radJSkip()
	if $radJ[$radJP] = "}"
		$radJP++
		return aOut
	ok
	while true
		radJSkip()
		cKey = radJParseString()
		radJSkip()
		$radJP++                         # ':'
		vVal = radJParseValue()
		aOut + [cKey, vVal]
		radJSkip()
		ch = $radJ[$radJP]
		$radJP++
		if ch = "}" return aOut ok
	end

func radJParseArray
	aOut = []
	$radJP++
	radJSkip()
	if $radJ[$radJP] = "]"
		$radJP++
		return aOut
	ok
	while true
		vVal = radJParseValue()
		aOut + vVal
		radJSkip()
		ch = $radJ[$radJP]
		$radJP++
		if ch = "]" return aOut ok
	end

func radJParseString
	$radJP++                             # opening quote
	c = ""
	nLen = len($radJ)
	while $radJP <= nLen
		ch = $radJ[$radJP]
		if ch = $radQ
			$radJP++
			return c
		ok
		if ch = $radBS
			$radJP++
			e = $radJ[$radJP]
			if e = "n" c += nl
			elseif e = "t" c += char(9)
			elseif e = "r" c += char(13)
			elseif e = "b" c += char(8)
			elseif e = "f" c += char(12)
			elseif e = "u"
				nCode = radHexVal(substr($radJ, $radJP + 1, 4))
				$radJP += 4
				if nCode >= 55296 and nCode <= 56319 and substr($radJ, $radJP + 1, 2) = $radBS + "u"
					nLow = radHexVal(substr($radJ, $radJP + 3, 4))
					nCode = 65536 + (nCode - 55296) * 1024 + (nLow - 56320)
					$radJP += 6
				ok
				c += radUtf8(nCode)
			else
				c += e
			ok
			$radJP++
		else
			c += ch
			$radJP++
		ok
	end
	raise("radcall: bad JSON (unterminated string)")

func radHexVal cHex
	n = 0
	cHex = lower(cHex)
	for i = 1 to len(cHex)
		n = n * 16 + substr("0123456789abcdef", cHex[i]) - 1
	next
	return n

func radUtf8 n
	if n < 128 return char(n) ok
	if n < 2048 return char(192 + floor(n / 64)) + char(128 + (n % 64)) ok
	if n < 65536
		return char(224 + floor(n / 4096)) + char(128 + (floor(n / 64) % 64)) + char(128 + (n % 64))
	ok
	return char(240 + floor(n / 262144)) + char(128 + (floor(n / 4096) % 64)) +
	       char(128 + (floor(n / 64) % 64)) + char(128 + (n % 64))

func radJParseNumber
	nStart = $radJP
	while $radJP <= len($radJ) and substr("+-0123456789.eE", $radJ[$radJP]) > 0
		$radJP++
	end
	cNum = substr($radJ, nStart, $radJP - nStart)
	if cNum = "" raise("radcall: bad JSON near position " + nStart) ok
	return number(cNum)
