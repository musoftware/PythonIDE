{
  "version": 1,
  "props": {
    "Name": "Form1",
    "Text": "IDE Blend",
    "Width": 400,
    "Height": 300,
    "BackColor": "",
    "StartPosition": "CenterScreen",
    "FormBorderStyle": "Sizable",
    "TopMost": false,
    "WindowState": "Normal",
    "Icon": "",
    "ScaleMode": "Pixel"
  },
  "controls": [
    {
      "type": "Button",
      "props": {
        "Name": "Button1",
        "Text": "Button1",
        "Left": 10,
        "Top": 10,
        "Width": 75,
        "Height": 23,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Left",
        "Parent": ""
      },
      "states": {
        "MouseOver": {
          "BackColor": "#3399FF",
          "Text": "Hovered"
        }
      }
    },
    {
      "type": "ListBox",
      "props": {
        "Name": "lstPeople",
        "Left": 10,
        "Top": 50,
        "Width": 120,
        "Height": 95,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "Items": "",
        "Parent": ""
      }
    },
    {
      "type": "Label",
      "props": {
        "Name": "Label1",
        "Text": "Label1",
        "Left": 200,
        "Top": 50,
        "Width": 60,
        "Height": 17,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Left",
        "Parent": ""
      }
    }
  ],
  "datasources": [
    {
      "name": "SampleData1",
      "file": "SampleData1.json"
    }
  ],
  "bindings": [
    {
      "control": "lstPeople",
      "property": "Items",
      "source": "SampleData1",
      "field": "Name"
    },
    {
      "control": "Label1",
      "property": "Text",
      "source": "SampleData1",
      "field": "City"
    }
  ],
  "storyboards": [
    {
      "name": "Storyboard1",
      "autostart": true,
      "repeat": false,
      "autoreverse": false,
      "tracks": [
        {
          "target": "Button1",
          "property": "Left",
          "keys": [
            [
              0,
              10
            ],
            [
              1000,
              250
            ]
          ]
        },
        {
          "target": "Button1",
          "property": "Top",
          "keys": [
            [
              0,
              10
            ],
            [
              600,
              80
            ]
          ]
        }
      ]
    }
  ]
}