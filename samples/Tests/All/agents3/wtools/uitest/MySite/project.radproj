{
  "name": "MySite",
  "language": "php-web",
  "forms": [],
  "startup": "",
  "modules": [],
  "web": {
    "root": ".",
    "start": "index.php"
  },
  "publish": [
    {
      "name": "Local copy",
      "kind": "folder",
      "host": "",
      "port": 0,
      "user": "",
      "remote_dir": "",
      "site_url": "",
      "local_dir": "",
      "passive": true,
      "verify_tls": true,
      "host_key": "",
      "key_file": "",
      "excludes": [
        ".git",
        ".svn",
        ".hg",
        ".radide",
        ".radide_backup*",
        "project.radproj",
        "*.radsln",
        "__pycache__",
        "*.pyc",
        ".vscode",
        ".idea",
        "Thumbs.db",
        ".DS_Store",
        "*.bak",
        "*.tmp",
        "~$*",
        "data/*.sqlite",
        "data/*.sqlite-*",
        "data/*.db",
        "data/sessions"
      ],
      "delete_removed": false,
      "save_password": true,
      "timeout": 30
    },
    {
      "name": "FTP host",
      "kind": "ftp",
      "host": "127.0.0.1",
      "port": 58461,
      "user": "web",
      "remote_dir": "/htdocs",
      "site_url": "",
      "local_dir": "",
      "passive": true,
      "verify_tls": true,
      "host_key": "",
      "key_file": "",
      "excludes": [
        ".git",
        ".svn",
        ".hg",
        ".radide",
        ".radide_backup*",
        "project.radproj",
        "*.radsln",
        "__pycache__",
        "*.pyc",
        ".vscode",
        ".idea",
        "Thumbs.db",
        ".DS_Store",
        "*.bak",
        "*.tmp",
        "~$*",
        "data/*.sqlite",
        "data/*.sqlite-*",
        "data/*.db",
        "data/sessions"
      ],
      "delete_removed": false,
      "save_password": true,
      "timeout": 30
    }
  ]
}