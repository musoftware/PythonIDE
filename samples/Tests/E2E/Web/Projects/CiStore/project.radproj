{
  "name": "CiStore",
  "language": "php-web",
  "forms": [],
  "startup": "",
  "modules": [],
  "kind": "website",
  "web": {
    "root": "public",
    "start": "index.php",
    "port": 0,
    "live_reload": true,
    "framework": "codeigniter",
    "php": "8.4",
    "template": "codeigniter4"
  },
  "databases": [
    {
      "name": "database",
      "kind": "sqlite",
      "path": "writable/database.db"
    }
  ],
  "publish": [
    {
      "name": "Default",
      "kind": "ftp",
      "host": "",
      "port": 0,
      "user": "",
      "remote_dir": "/",
      "site_url": "",
      "local_dir": "",
      "passive": true,
      "verify_tls": true,
      "host_key": "",
      "key_file": "",
      "excludes": [
        ".git",
        ".svn",
        ".hg",
        ".radide",
        ".radide_backup*",
        "project.radproj",
        "*.radsln",
        "__pycache__",
        "*.pyc",
        ".vscode",
        ".idea",
        "Thumbs.db",
        ".DS_Store",
        "*.bak",
        "*.tmp",
        "~$*",
        "data/*.sqlite",
        "data/*.sqlite-*",
        "data/*.db",
        "data/sessions",
        "database/*.sqlite",
        "database/*.sqlite-*",
        "storage/*.sqlite3",
        "storage/*.sqlite3-*",
        "storage/framework/sessions",
        "writable/*.db",
        "writable/session"
      ],
      "delete_removed": false,
      "save_password": true,
      "timeout": 30
    },
    {
      "name": "Local folder",
      "kind": "folder",
      "host": "",
      "port": 0,
      "user": "",
      "remote_dir": "",
      "site_url": "",
      "local_dir": "",
      "passive": true,
      "verify_tls": true,
      "host_key": "",
      "key_file": "",
      "excludes": [
        ".git",
        ".svn",
        ".hg",
        ".radide",
        ".radide_backup*",
        "project.radproj",
        "*.radsln",
        "__pycache__",
        "*.pyc",
        ".vscode",
        ".idea",
        "Thumbs.db",
        ".DS_Store",
        "*.bak",
        "*.tmp",
        "~$*",
        "data/*.sqlite",
        "data/*.sqlite-*",
        "data/*.db",
        "data/sessions",
        "database/*.sqlite",
        "database/*.sqlite-*",
        "storage/*.sqlite3",
        "storage/*.sqlite3-*",
        "storage/framework/sessions",
        "writable/*.db",
        "writable/session",
        "writable/logs",
        "writable/cache",
        "writable/debugbar"
      ],
      "delete_removed": false,
      "save_password": true,
      "timeout": 30
    }
  ],
  "deploy": []
}
