  ],
  "animations": [
    {
      "id": "fx1",
      "target": "lblTitle",
      "preset": "slideIn",
      "params": {
        "from": "left",
        "distance": 120,
        "fade": true
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx2",
      "target": "cmdShake",
      "preset": "shake",
      "params": {
        "distance": 10
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx3",
      "target": "cmdMove",
      "preset": "move",
      "params": {
        "dx": 60,
        "dy": 0
      },
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx4",
      "target": "cmdMove",
      "preset": "bounce",
      "params": {
        "height": 20
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "after",
        "after": "fx3"
      },
      "enabled": true
    },
    {
      "id": "fx5",
      "target": "pnlBox",
      "preset": "colorTo",
      "params": {
        "prop": "BackColor",
        "color": "#ff7a59"
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "inout",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click",
        "source": "cmdColor"
      },
      "enabled": true
    },
    {
      "id": "fx6",
      "target": "lblType",
      "preset": "typewriter",
      "params": {},
      "durationMs": 900,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "after",
        "after": "fx1"
      },
      "enabled": true
    },
    {
      "id": "fx7",
      "target": "pnlTimer",
      "preset": "colorTo",
      "params": {
        "prop": "BackColor",
        "color": "#aa0000"
      },
      "durationMs": 400,
      "delayMs": 0,
      "easing": "inout",
      "repeat": 1,
      "autoreverse": true,
      "trigger": {
        "on": "timer",
        "intervalMs": 1500
      },
      "enabled": true
    },
    {
      "id": "fx8",
      "target": "lblManual",
      "preset": "move",
      "params": {
        "dx": 80,
        "dy": 0
      },
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "manual"
      },
      "enabled": true
    }
  ],
  "motion": {
    "respectReducedMotion": true
  },
  "states": {
    "Alert": {
      "Text": "ALERT",
      "BackColor": "#ffdddd"
    }
  },
  "variants": {
    "sizes": [
      {
        "id": "compact",
        "label": "Small",
        "when": {
          "maxWidth": 399
        },
        "preview": {
          "width": 380,
          "height": 320
        }
      },
      {
        "id": "wide",
        "label": "Wide",
        "when": {
          "minWidth": 700
        },
        "preview": {
          "width": 760,
          "height": 320
        }
      }
    ]
  }
}