{
 "version": 1,
 "name": "Catalog",
 "route": "/",
 "theme": {},
 "assets": [],
 "fonts": [],
 "tree": {
  "id": "w1",
  "type": "Scaffold",
  "slots": {
   "appBar": {
    "id": "w2",
    "type": "AppBar",
    "slots": {
     "title": {
      "id": "w3",
      "type": "Text",
      "ctor": "rich",
      "props": {
       "spans": [
        {
         "text": "Fruit "
        },
        {
         "text": "Market",
         "style": {
          "fontWeight": "FontWeight.bold",
          "color": "#FF6750A4"
         }
        }
       ]
      }
     }
    }
   },
   "body": {
    "id": "w4",
    "type": "Column",
    "props": {
     "crossAxisAlignment": "CrossAxisAlignment.stretch"
    },
    "children": [
     {
      "id": "w5",
      "type": "Padding",
      "props": {
       "padding": {
        "all": 16
       }
      },
      "slots": {
       "child": {
        "id": "w6",
        "type": "RichText",
        "props": {
         "spans": [
          {
           "text": "Fresh ",
           "style": {
            "color": "#FF1F1F1F",
            "fontSize": 18
           }
          },
          {
           "text": "today",
           "style": {
            "color": "#FF00897B",
            "fontSize": 18,
            "fontStyle": "FontStyle.italic",
            "shadows": [
             {
              "color": "#55000000",
              "blur": 2,
              "offset": [
               1,
               1
              ]
             }
            ]
           }
          },
          {
           "text": " - tap a fruit",
           "style": {
            "color": "#FF757575",
            "fontSize": 14
           }
          }
         ],
         "textAlign": "TextAlign.center"
        }
       }
      }
     },
     {
      "id": "w7",
      "type": "Expanded",
      "props": {
       "flex": 2
      },
      "slots": {
       "child": {
        "id": "w8",
        "type": "ListView",
        "ctor": "builder",
        "name": "lstFruit",
        "props": {
         "itemCount": 6,
         "items": [
          "Apple",
          "Banana",
          "Cherry",
          "Mango",
          "Orange",
          "Pear"
         ],
         "padding": {
          "h": 8
         }
        },
        "slots": {
         "itemBuilder": {
          "id": "w9",
          "type": "Card",
          "slots": {
           "child": {
            "id": "w10",
            "type": "ListTile",
            "slots": {
             "leading": {
              "id": "w11",
              "type": "CircleAvatar",
              "slots": {
               "child": {
                "id": "w12",
                "type": "Text",
                "props": {
                 "data": {
                  "$code": "'${index + 1}'"
                 }
                }
               }
              }
             },
             "title": {
              "id": "w13",
              "type": "Text",
              "props": {
               "data": {
                "$code": "item"
               }
              }
             },
             "subtitle": {
              "id": "w14",
              "type": "Text",
              "props": {
               "data": {
                "$code": "'Item number $index'"
               }
              }
             },
             "trailing": {
              "id": "w15",
              "type": "Icon",
              "props": {
               "icon": "Icons.chevron_right"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     {
      "id": "w16",
      "type": "Expanded",
      "props": {
       "flex": 1
      },
      "slots": {
       "child": {
        "id": "w17",
        "type": "GridView",
        "ctor": "builder",
        "props": {
         "crossAxisCount": 3,
         "mainAxisSpacing": 8,
         "crossAxisSpacing": 8,
         "itemCount": 9,
         "padding": {
          "all": 8
         }
        },
        "slots": {
         "itemBuilder": {
          "id": "w18",
          "type": "Container",
          "props": {
           "alignment": "Alignment.center",
           "decoration": {
            "color": "#FFE8DEF8",
            "borderRadius": 12
           }
          },
          "slots": {
           "child": {
            "id": "w19",
            "type": "Text",
            "props": {
             "data": {
              "$code": "'Box $index'"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    ]
   }
  }
 }
}
