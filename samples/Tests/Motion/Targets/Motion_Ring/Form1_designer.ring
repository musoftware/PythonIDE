func Form1_Show
    if isNull(Form1) Form1_Create() ok
    Form1.show()

func Form1_BeginAnimation cId
    RadFx_Begin(RadFx_ByName("Form1." + cId))

func Form1_StopAnimation cId
    RadFx_Stop(RadFx_ByName("Form1." + cId))

# Visible with the On show / On hide animations:  Form1_SetVisible("Label1", false)
func Form1_SetVisible cName, lOn
    nW = 0
    if lower(cName) = "lblinfo"
        RadFx_SetVisible(RadFx_WidgetOf(lblInfo.pObject), lOn, [RadFx_ByName("Form1.fx9")], [RadFx_ByName("Form1.fx8")])
        return
    ok
    eval(cName + ".setVisible(" + lOn + ")")
