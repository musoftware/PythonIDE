  "animations": [
    {
      "id": "fx1",
      "target": "lblTitle",
      "preset": "slideIn",
      "params": {
        "from": "left",
        "distance": 120,
        "fade": true
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx2",
      "target": "lblTitle",
      "preset": "typewriter",
      "params": {},
      "durationMs": 900,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx3",
      "target": "btnShake",
      "preset": "shake",
      "params": {
        "distance": 10
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx4",
      "target": "btnPulse",
      "preset": "zoom",
      "params": {
        "scale": 1.15
      },
      "durationMs": 250,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "hover",
        "leave": "reverse"
      },
      "enabled": true
    },
    {
      "id": "fx5",
      "target": "btnMove",
      "preset": "move",
      "params": {
        "dx": 60,
        "dy": 0
      },
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx6",
      "target": "btnMove",
      "preset": "bounce",
      "params": {
        "height": 20
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "after",
        "after": "fx5"
      },
      "enabled": true
    },
    {
      "id": "fx7",
      "target": "btnSpin",
      "preset": "rotate",
      "params": {
        "angle": 360
      },
      "durationMs": 800,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx8",
      "target": "lblInfo",
      "preset": "fadeOut",
      "params": {},
      "durationMs": 400,
      "delayMs": 0,
      "easing": "in",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "hide"
      },
      "enabled": true
    },
    {
      "id": "fx9",
      "target": "lblInfo",
      "preset": "fadeIn",
      "params": {},
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "show"
      },
      "enabled": true
    },
    {
      "id": "fx10",
      "target": "pnlBox",
      "preset": "colorTo",
      "params": {
        "prop": "BackColor",
        "color": "#ff7a59"
      },
      "durationMs": 700,
      "delayMs": 0,
      "easing": "inout",
      "repeat": 1,
      "autoreverse": true,
      "trigger": {
        "on": "timer",
        "intervalMs": 2500
      },
      "enabled": true
    },
    {
      "id": "fx11",
      "target": "btnFlip",
      "preset": "flip",
      "params": {
        "axis": "x"
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx12",
      "target": "btnFlip",
      "preset": "pulse",
      "params": {
        "scale": 1.08
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "inout",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "after",
        "after": "fx11"
      },
      "enabled": true
    },
    {
      "id": "fx13",
      "target": "btnHide",
      "preset": "scaleIn",
      "params": {
        "scale": 0.3
      },
      "durationMs": 500,
      "delayMs": 300,
      "easing": "back",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx14",
      "target": "btnHide",
      "preset": "slideOut",
      "params": {
        "from": "right",
        "distance": 80,
        "fade": true
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "in",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "manual"
      },
      "enabled": true
    },
    {
      "id": "fx15",
      "target": "pnlBox",
      "preset": "scaleOut",
      "params": {
        "scale": 0.3
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "in",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "manual"
      },
      "enabled": true
    },
    {
      "id": "fx16",
      "target": "pnlBox",
      "preset": "fadeIn",
      "params": {},
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "manual"
      },
      "enabled": true
    }
  ],
  "motion": {
    "respectReducedMotion": true
  }
}