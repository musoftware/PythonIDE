{
  "version": 2,
  "props": {
    "Name": "Form1",
    "Text": "Motion presets",
    "Width": 460,
    "Height": 300,
    "BackColor": "#f4f6fb",
    "StartPosition": "CenterScreen",
    "FormBorderStyle": "Sizable",
    "TopMost": false,
    "WindowState": "Normal",
    "Icon": "",
    "ScaleMode": "Pixel"
  },
  "controls": [
    {
      "type": "Label",
      "props": {
        "Name": "lblTitle",
        "Text": "Hello, motion!",
        "Left": 20,
        "Top": 14,
        "Width": 300,
        "Height": 28,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 14,
        "FontBold": true,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Left",
        "DataSource": "",
        "DataMember": "",
        "Parent": ""
      }
    },
    {
      "type": "Button",
      "props": {
        "Name": "cmdShake",
        "Text": "Shake me",
        "Left": 20,
        "Top": 60,
        "Width": 110,
        "Height": 30,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Center",
        "Parent": ""
      }
    },
    {
      "type": "Button",
      "props": {
        "Name": "btnPulse",
        "Text": "Hover me",
        "Left": 150,
        "Top": 60,
        "Width": 110,
        "Height": 30,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Center",
        "Parent": ""
      }
    },
    {
      "type": "Button",
      "props": {
        "Name": "cmdMove",
        "Text": "Move + bounce",
        "Left": 20,
        "Top": 110,
        "Width": 110,
        "Height": 30,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Center",
        "Parent": ""
      }
    },
    {
      "type": "Button",
      "props": {
        "Name": "btnSpin",
        "Text": "Rotate",
        "Left": 150,
        "Top": 110,
        "Width": 110,
        "Height": 30,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Center",
        "Parent": ""
      }
    },
    {
      "type": "Button",
      "props": {
        "Name": "cmdHide",
        "Text": "Hide / show",
        "Left": 20,
        "Top": 160,
        "Width": 110,
        "Height": 30,
        "BackColor": "",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Center",
        "Parent": ""
      }
    },
    {
      "type": "Label",
      "props": {
        "Name": "lblInfo",
        "Text": "I fade out and in",
        "Left": 150,
        "Top": 164,
        "Width": 260,
        "Height": 24,
        "BackColor": "#ffe08a",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "TextAlign": "Left",
        "DataSource": "",
        "DataMember": "",
        "Parent": ""
      }
    },
    {
      "type": "Panel",
      "props": {
        "Name": "pnlBox",
        "Left": 300,
        "Top": 60,
        "Width": 120,
        "Height": 80,
        "BackColor": "#3399ff",
        "ForeColor": "",
        "FontName": "Segoe UI",
        "FontSize": 9,
        "FontBold": false,
        "FontItalic": false,
        "Enabled": true,
        "Visible": true,
        "ToolTip": "",
        "TabIndex": 0,
        "Anchor": "Top, Left",
        "Dock": "None",
        "Parent": ""
      }
    }
  ],
  "animations": [
    {
      "id": "fx1",
      "target": "lblTitle",
      "preset": "slideIn",
      "params": {
        "from": "left",
        "distance": 120,
        "fade": true
      },
      "durationMs": 600,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx2",
      "target": "lblTitle",
      "preset": "typewriter",
      "params": {},
      "durationMs": 900,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "load"
      },
      "enabled": true
    },
    {
      "id": "fx3",
      "target": "cmdShake",
      "preset": "shake",
      "params": {
        "distance": 10
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx4",
      "target": "btnPulse",
      "preset": "zoom",
      "params": {
        "scale": 1.15
      },
      "durationMs": 250,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "hover",
        "leave": "reverse"
      },
      "enabled": true
    },
    {
      "id": "fx5",
      "target": "cmdMove",
      "preset": "move",
      "params": {
        "dx": 60,
        "dy": 0
      },
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx6",
      "target": "cmdMove",
      "preset": "bounce",
      "params": {
        "height": 20
      },
      "durationMs": 500,
      "delayMs": 0,
      "easing": "linear",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "after",
        "after": "fx5"
      },
      "enabled": true
    },
    {
      "id": "fx7",
      "target": "btnSpin",
      "preset": "rotate",
      "params": {
        "angle": 360
      },
      "durationMs": 800,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "click"
      },
      "enabled": true
    },
    {
      "id": "fx8",
      "target": "lblInfo",
      "preset": "fadeOut",
      "params": {},
      "durationMs": 400,
      "delayMs": 0,
      "easing": "in",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "hide"
      },
      "enabled": true
    },
    {
      "id": "fx9",
      "target": "lblInfo",
      "preset": "fadeIn",
      "params": {},
      "durationMs": 400,
      "delayMs": 0,
      "easing": "out",
      "repeat": 1,
      "autoreverse": false,
      "trigger": {
        "on": "show"
      },
      "enabled": true
    },
    {
      "id": "fx10",
      "target": "pnlBox",
      "preset": "colorTo",
      "params": {
        "prop": "BackColor",
        "color": "#ff7a59"
      },
      "durationMs": 700,
      "delayMs": 0,
      "easing": "inout",
      "repeat": 1,
      "autoreverse": true,
      "trigger": {
        "on": "timer",
        "intervalMs": 2500
      },
      "enabled": true
    }
  ],
  "motion": {
    "respectReducedMotion": true
  }
}