{
  "name": "RAD Test",
  "scopeName": "source.radtest",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "name": "keyword.control.radtest", "match": "\\b(func|end|if|then|else|return)\\b" },
    { "name": "constant.numeric.radtest", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "match": "\\b(func)\\s+([A-Za-z_]\\w*)", "captures": { "2": { "name": "entity.name.function.radtest" } } }
  ],
  "repository": {
    "comment": { "name": "comment.line.double-dash.radtest", "begin": "--", "end": "$" },
    "string": {
      "name": "string.quoted.double.radtest", "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.radtest", "match": "\\\\." }]
    }
  }
}
