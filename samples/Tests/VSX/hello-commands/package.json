{
  "name": "hello-commands",
  "displayName": "RAD IDE Test: Hello Commands",
  "description": "Test extension for the RAD IDE extension host: commands, status bar, messages, quick pick, input box, output channel, configuration, state, document events and language providers.",
  "version": "0.0.1",
  "publisher": "radide-test",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onLanguage:plaintext"],
  "contributes": {
    "commands": [
      { "command": "helloCommands.sayHello", "title": "Say Hello", "category": "Hello" },
      { "command": "helloCommands.pick", "title": "Pick a Fruit", "category": "Hello" },
      { "command": "helloCommands.ask", "title": "Ask Your Name", "category": "Hello" },
      { "command": "helloCommands.insertDate", "title": "Insert Date", "category": "Hello" },
      { "command": "helloCommands.state", "title": "Show Counters", "category": "Hello" }
    ],
    "menus": {
      "editor/context": [ { "command": "helloCommands.insertDate", "when": "editorLangId == plaintext", "group": "navigation" } ],
      "commandPalette": [ { "command": "helloCommands.insertDate", "when": "editorLangId == plaintext" } ]
    },
    "configuration": {
      "title": "Hello Commands",
      "properties": {
        "helloCommands.greeting": { "type": "string", "default": "Hello", "description": "The greeting word." },
        "helloCommands.shout": { "type": "boolean", "default": false, "description": "Upper-case the greeting." }
      }
    }
  }
}
