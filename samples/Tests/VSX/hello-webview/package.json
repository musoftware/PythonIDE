{
  "name": "hello-webview",
  "publisher": "radide-test",
  "displayName": "Hello Webview",
  "version": "0.0.1",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "helloWebview", "title": "Hello Webview", "icon": "media/icon.svg" }] },
    "views": { "helloWebview": [{ "type": "webview", "id": "helloWebview.view", "name": "Hello View" }] },
    "commands": [{ "command": "helloWebview.openPanel", "title": "Hello Webview: Open Panel" }]
  }
}
