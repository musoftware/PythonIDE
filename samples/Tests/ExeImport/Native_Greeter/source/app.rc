#include <windows.h>
#include "res.h"
IDR_MENU MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&Clear\tCtrl+L", IDM_CLEAR
    MENUITEM SEPARATOR
    MENUITEM "E&xit", IDM_EXIT
  END
  POPUP "&Help"
  BEGIN
    MENUITEM "&About...", IDM_ABOUT
  END
END
IDD_MAIN DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Greeter"
MENU IDR_MENU
FONT 8, "MS Shell Dlg"
BEGIN
  LTEXT "Your name:", -1, 7, 9, 50, 8
  EDITTEXT IDC_NAME, 60, 7, 110, 14, ES_AUTOHSCROLL
  DEFPUSHBUTTON "&Greet", IDC_GREET, 178, 6, 55, 16
  AUTOCHECKBOX "Upper case", IDC_UPPER, 60, 26, 80, 10
  GROUPBOX "Colour", IDC_COLOR, 7, 42, 110, 40
  AUTORADIOBUTTON "Red", IDC_RED, 15, 54, 40, 10
  AUTORADIOBUTTON "Blue", IDC_BLUE, 15, 66, 40, 10
  LISTBOX IDC_LIST, 125, 42, 108, 60, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
  CTEXT "", IDC_RESULT, 7, 110, 226, 12, SS_SUNKEN
  CONTROL "", -1, "msctls_progress32", 0, 7, 128, 226, 10
  PUSHBUTTON "Close", IDCANCEL, 178, 140, 55, 14
END
IDD_ABOUT DIALOG 0, 0, 180, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Greeter"
FONT 8, "MS Sans Serif"
BEGIN
  ICON 1, -1, 7, 7, 21, 20
  LTEXT "Greeter 1.0 - a test program", -1, 40, 10, 130, 8
  DEFPUSHBUTTON "OK", IDOK, 120, 48, 50, 14
END
STRINGTABLE
BEGIN
  IDS_HELLO "Hello, %s!"
  IDS_BYE "Goodbye"
END
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "RAD Test"
      VALUE "FileDescription", "Greeter test program"
      VALUE "FileVersion", "1.2.0.0"
      VALUE "ProductName", "Greeter"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
