{
 "format": "radreport",
 "version": 1,
 "name": "ArabicSales",
 "title": "تقرير المبيعات حسب العميل",
 "page": {
  "size": "A4",
  "orientation": "Portrait",
  "margins": [
   36,
   36,
   36,
   36
  ]
 },
 "rightToLeft": true,
 "mirrorLayout": true,
 "font": {
  "name": "Segoe UI",
  "size": 10
 },
 "dataSource": {
  "type": "sql",
  "connection": {
   "kind": "sqlite",
   "path": "shop.db"
  },
  "query": "SELECT c.NameAr AS Customer, p.NameAr AS Product, p.Category, l.Qty, l.Qty * l.Price AS Amount\nFROM InvoiceLines l JOIN Invoices i ON i.Id = l.InvoiceId JOIN Customers c ON c.Id = i.CustomerId\nJOIN Products p ON p.Id = l.ProductId ORDER BY c.Id, p.Id"
 },
 "parameters": [],
 "sort": [],
 "filter": "",
 "sortByGroups": false,
 "groups": [
  {
   "name": "Customer",
   "field": "Customer",
   "expression": "",
   "newPage": false,
   "repeatHeader": true,
   "keepTogether": true,
   "sort": "asc",
   "header": {
    "height": 28,
    "back": "#EAF3EA",
    "items": [
     {
      "type": "text",
      "name": "gCust",
      "x": 0,
      "y": 4,
      "w": 400,
      "h": 20,
      "text": "العميل: {Customer}",
      "bold": true,
      "fontSize": 12,
      "color": "#1B5E20"
     }
    ]
   },
   "footer": {
    "height": 26,
    "items": [
     {
      "type": "line",
      "name": "gLine",
      "x": 220,
      "y": 1,
      "w": 303,
      "h": 2
     },
     {
      "type": "text",
      "name": "gLbl",
      "x": 0,
      "y": 4,
      "w": 220,
      "h": 18,
      "text": "إجمالي {Customer}",
      "bold": true
     },
     {
      "type": "expression",
      "name": "gSum",
      "x": 290,
      "y": 4,
      "w": 100,
      "h": 18,
      "expression": "Sum('Amount')",
      "format": "N2",
      "bold": true
     },
     {
      "type": "text",
      "name": "gCnt",
      "x": 390,
      "y": 4,
      "w": 133,
      "h": 18,
      "text": "عدد البنود: {Count()}",
      "color": "#606060"
     }
    ]
   }
  }
 ],
