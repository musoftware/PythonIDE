{
 "format": "radreport",
 "version": 1,
 "name": "Invoices",
 "title": "Sales Invoices",
 "page": {
  "size": "A4",
  "orientation": "Portrait",
  "margins": [
   36,
   36,
   36,
   36
  ]
 },
 "rightToLeft": false,
 "mirrorLayout": false,
 "currency": "",
 "font": {
  "name": "Segoe UI",
  "size": 9
 },
 "dataSource": {
  "type": "sql",
  "connection": {
   "kind": "sqlite",
   "path": "shop.db"
  },
  "query": "SELECT i.Id AS InvoiceNo, i.Date, c.Name AS Customer, c.NameAr AS CustomerAr, c.City,\n       p.Name AS Product, p.Category, l.Qty, l.Price, l.Qty * l.Price AS Amount\nFROM InvoiceLines l\n  JOIN Invoices i ON i.Id = l.InvoiceId\n  JOIN Customers c ON c.Id = i.CustomerId\n  JOIN Products p ON p.Id = l.ProductId\nWHERE (:CustomerId IS NULL OR c.Id = :CustomerId)\nORDER BY c.Name, i.Id, l.Id"
 },
 "parameters": [
  {
   "name": "CustomerId",
   "type": "int",
   "default": null,
   "prompt": "Customer Id (empty = all)"
  },
  {
   "name": "TaxRate",
   "type": "float",
   "default": 0.14,
   "prompt": "Tax rate"
  }
 ],
 "sort": [],
 "filter": "",
 "sortByGroups": false,
 "groups": [
  {
   "name": "Customer",
   "field": "Customer",
   "expression": "",
   "newPage": true,
   "repeatHeader": true,
   "keepTogether": false,
   "sort": "asc",
   "header": {
    "height": 34,
    "back": "#E8EEF7",
    "items": [
     {
      "type": "text",
      "name": "txtCustomer",
      "x": 4,
      "y": 4,
      "w": 300,
      "h": 26,
      "text": "Customer: {Customer}",
      "fontSize": 13,
      "bold": true,
      "color": "#1F3D7A"
     },
     {
      "type": "text",
      "name": "txtCustomerAr",
      "x": 310,
      "y": 4,
      "w": 209,
      "h": 26,
      "text": "{CustomerAr}",
      "fontSize": 13,
      "bold": true,
      "align": "right",
      "rtl": true,
      "color": "#1F3D7A"
     },
     {
      "type": "text",
      "name": "txtContinued",
      "x": 200,
      "y": 4,
      "w": 120,
      "h": 26,
      "text": "{IIf(Continued, '(continued)', '')}",
      "italic": true,
      "color": "#808080"
     }
    ]
   },
   "footer": {
    "height": 30,
    "items": [
     {
      "type": "line",
      "name": "lnCust",
      "x": 270,
      "y": 2,
      "w": 253,
      "h": 2
     },
     {
      "type": "text",
      "name": "lblCustTotal",
      "x": 200,
      "y": 6,
      "w": 190,
      "h": 20,
      "text": "Total for {Customer}:",
      "bold": true,
      "align": "right"
     },
     {
      "type": "expression",
      "name": "sumCust",
      "x": 390,
      "y": 6,
      "w": 70,
      "h": 20,
      "expression": "Sum('Amount')",
      "format": "N2",
      "bold": true,
      "align": "right"
     },
     {
      "type": "text",
      "name": "lblCustInv",
      "x": 0,
      "y": 6,
      "w": 190,
      "h": 20,
      "text": "{CountDistinct('InvoiceNo')} invoice(s)",
      "color": "#606060"
     }
    ]
   }
  },
  {
   "name": "Invoice",
   "field": "InvoiceNo",
   "expression": "",
   "newPage": false,
   "repeatHeader": true,
   "keepTogether": true,
   "sort": "asc",
   "header": {
    "height": 26,
    "items": [
     {
      "type": "text",
      "name": "txtInvoice",
      "x": 0,
      "y": 4,
      "w": 330,
      "h": 18,
      "text": "Invoice #{InvoiceNo}    Date: {Date:dd/MM/yyyy}    City: {City}",
      "bold": true
     },
     {
      "type": "barcode",
      "name": "bcInvoice",
      "x": 383,
      "y": 2,
      "w": 140,
      "h": 22,
      "field": "InvoiceNo",
      "barcodeType": "code128",
      "showText": false
     }
    ]
   },
   "footer": {
    "height": 58,
    "items": [
     {
      "type": "line",
      "name": "lnInv",
      "x": 320,
      "y": 1,
      "w": 203,
      "h": 2
     },
     {
      "type": "text",
      "name": "lblSub",
      "x": 270,
      "y": 4,
      "w": 120,
      "h": 16,
      "text": "Subtotal",
      "align": "right"
     },
     {
      "type": "expression",
      "name": "sumSub",
      "x": 390,
      "y": 4,
      "w": 70,
      "h": 16,
      "expression": "Sum('Amount')",
      "format": "N2",
      "align": "right"
     },
     {
      "type": "text",
      "name": "lblTax",
      "x": 270,
      "y": 20,
      "w": 120,
      "h": 16,
      "text": "Tax {Parameters.TaxRate:P0}",
      "align": "right"
     },
     {
      "type": "expression",
      "name": "sumTax",
      "x": 390,
      "y": 20,
      "w": 70,
      "h": 16,
      "expression": "Sum('Amount') * Parameters.TaxRate",
      "format": "N2",
      "align": "right"
     },
     {
      "type": "text",
      "name": "lblTot",
      "x": 270,
      "y": 36,
      "w": 120,
      "h": 18,
      "text": "Invoice total",
      "align": "right",
      "bold": true
     },
     {
      "type": "expression",
      "name": "sumTot",
      "x": 390,
      "y": 36,
      "w": 70,
      "h": 18,
      "expression": "Sum('Amount') * (1 + Parameters.TaxRate)",
      "format": "N2",
      "align": "right",
      "bold": true,
      "border": 0.8,
      "borderColor": "#1F3D7A"
     },
     {
      "type": "text",
      "name": "lblLines",
      "x": 0,
      "y": 4,
      "w": 200,
      "h": 16,
      "text": "{Count()} line(s), {Sum('Qty')} item(s)",
      "color": "#606060"
     }
    ]
   }
  }
 ],
 "bands": {
  "reportHeader": {
   "height": 78,
