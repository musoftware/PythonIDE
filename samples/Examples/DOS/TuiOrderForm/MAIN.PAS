procedure btnOrder_Click;
{ >>> USER CODE btnOrder_Click (kept when the screens are regenerated) }
var Name, Line: string; Price: Integer;
begin
  Name := TuiGetText(txtName);
  if Name = '' then
  begin
    TuiMsgBox('Order', 'Please type the customer name.');
    Exit;
  end;
  if Orders >= 10 then
  begin
    TuiMsgBox('Order', 'The list is full - choose File > New order.');
    Exit;
  end;
  if TuiGetValue(optSmall) <> 0 then begin Price := 10; Line := 'S'; end
  else if TuiGetValue(optLarge) <> 0 then begin Price := 20; Line := 'L'; end
  else begin Price := 15; Line := 'M'; end;
  Line := Name + ' ' + Line;
  if TuiGetValue(chkMilk) <> 0 then begin Price := Price + 3; Line := Line + ' +milk'; end;
  if TuiGetValue(chkShot) <> 0 then begin Price := Price + 5; Line := Line + ' +shot'; end;
  if TuiGetValue(chkTakeaway) <> 0 then Line := Line + ' (away)';
  Line := Line + ' = ' + IntText(Price);
  TuiAddItem(lstOrders, Line);
  Inc(Orders);
  Total := Total + Price;
  TuiSetValue(prgOrders, Orders);
  TuiSetText(lblCount, IntText(Orders) + ' / 10');
  TuiSetText(lblTotal, 'Total: ' + IntText(Total) + '  (last: ' + Name + ')');
  ResetForm;
end;
{ <<< END USER CODE }

