  "dbsources": [
    {
      "name": "Contacts",
      "connection": {
        "name": "ContactsDb",
        "kind": "sqlite",
        "path": "contacts.db"
      },
      "table": "Contacts",
      "query": "",
      "columns": [
        {
          "name": "Id",
          "type": "INTEGER",
          "pk": 1,
          "autoinc": true
        },
        {
          "name": "Name",
          "type": "TEXT",
          "notnull": true
        },
        {
          "name": "Phone",
          "type": "TEXT"
        },
        {
          "name": "Email",
          "type": "TEXT"
        },
        {
          "name": "City",
          "type": "TEXT"
        },
        {
          "name": "Favorite",
          "type": "BOOLEAN",
          "default": "0"
        }
      ],
      "key": [
        "Id"
      ],
      "filter": "",
      "sort": "",
      "autofill": true,
      "navigator": {
        "MoveFirst": "ContactsBindingNavigatorMoveFirstItem",
        "MovePrevious": "ContactsBindingNavigatorMovePreviousItem",
        "Position": "ContactsBindingNavigatorPositionItem",
        "MoveNext": "ContactsBindingNavigatorMoveNextItem",
        "MoveLast": "ContactsBindingNavigatorMoveLastItem"
      }
    }
  ]
